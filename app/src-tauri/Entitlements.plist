<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime blocks the mic unless this is declared; without it macOS denies silently
       and the app never appears in System Settings > Privacy > Microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
