{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interview Agent",
  "version": "0.1.0",
  "identifier": "dev.interview-agent.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "모의 면접",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/dist/interview-agent-backend/": "backend/"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    },
    "shortDescription": "로컬 모의 면접 에이전트"
  }
}
